# ver1 circ with zne mitigation technique implemented

import numpy as np
import matplotlib.pyplot as plt
from qiskit import QuantumCircuit
# parallel to pile from sampler, gives single score
# essentially tells comp what question to ask abt circ
# adds both SparsePauliOp and Statevector from quantum_info
from qiskit.quantum_info import SparsePauliOp, Statevector
from qiskit.transpiler.preset_passmanagers import generate_preset_pass_manager
from qiskit_ibm_runtime import QiskitRuntimeService, EstimatorV2 as Estimator

# build phase, ghz circuit
circ = QuantumCircuit(3)
circ.h(0)
circ.cx(0, 1)
circ.cx(0, 2)

print(circ.draw())

sv = Statevector(circ)
probs = {str(k): float(v) for k, v in sv.probabilities_dict(decimals=3).items()}
print("Perfect result:", probs)
# if sv.probabilities_dict((decimals=3)) = error
# sv.probabilities_dict()

# perf ans = +1, (+1 = perf match, -1 = perfect opp, 0 = no rel.)
# H and CNOT gates produce plus ver, circ makes 000 + 111, that why no minus
observable = SparsePauliOp("XXX")

exact = float(sv.expectation_value(observable).real)
print(f"Exact value: {exact:.3f}")

# pick machine
service = QiskitRuntimeService(name="open")
backends = service.backends(operational=True, simulator=False, min_num_qubits=3)
backend = max(backends, key=lambda b: b.status().pending_jobs)
# least busy this time cause two queries
# backend = service.least_busy(operational=True, simulator=False, min_num_qubits=3)
print("Running on backend:", backend.name)

# circ translation
pm = generate_preset_pass_manager(optimization_level=1, backend=backend)
isa_circ = pm.run(circ)
# qubit num maps to new location
isa_observable = observable.apply_layout(isa_circ.layout)

# estimators, one mitigated one not
# not mitigated
plain = Estimator(mode=backend)
plain.options.resilience_level = 0

# mitigated
zne = Estimator(mode=backend)
zne.options.resilience_level = 0
zne.options.resilience.zne_mitigation = True
zne.options.resilience.zne.noise_factors = [1, 3, 5]
zne.options.resilience.zne.extrapolator = "exponential"

job_plain = plain.run([(isa_circ, isa_observable)])
job_zne = zne.run([(isa_circ, isa_observable)])
print("Plain job ID:", job_plain.job_id())
print("ZNE job ID:", job_zne.job_id())

# wait
unmitigated = float(np.array(job_plain.result()[0].data.evs).flatten()[0])
data = job_zne.result()[0].data
mitigated = float(np.array(data.evs).flatten()[0])

print(f"Unmitigated: {unmitigated:.3f}")
print(f"Mitigated:   {mitigated:.3f}")
print(f"Exact:       {exact:.3f}")
    
# plot
try:
    noise_factors = [1, 3, 5]
    raw_values = np.array(data.evs_noise_factors).flatten()
    errs = np.array(data.stds_noise_factors).flatten()
    xs = np.linspace(0, 5, 50)

    plt.errorbar(noise_factors, raw_values, yerr=errs, fmt="o", capsize=4, label="ZNE noise levels (1x, 3x, 5x)")

    if np.all(raw_values > 0):
        b, log_a = np.polyfit(noise_factors, np.log(raw_values), 1)
        plt.plot(xs, np.exp(log_a + b * xs), "--", label="Exponential fit")
    else: # unwanted scenario
        slope, intercept = np.polyfit(noise_factors, raw_values, 1)
        plt.plot(xs, slope * xs + intercept, "--", label = "Linear fit (fallback)")

    plt.scatter([1], [unmitigated], marker="s", s = 100, label="Unmitigated run")
    plt.scatter([0], [mitigated], marker="*", s = 200, label="Mitigated run (ZNE)")
    plt.axhline(exact, color="gray", linestyle=":", label=f"Exact value ({exact:.1f})")

    plt.xlabel("Noise level (1 = normal)")
    plt.ylabel("XXX expectation value")
    plt.title("GHZ with Error Mitigation")
    plt.legend()
    plt.savefig("zne_plot.png")
    plt.show()

except AttributeError:
    print("Plot fields not found. Version returns:")
    print(data)